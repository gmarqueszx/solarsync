# A porta de entrada do SolarSync: TLS, os arquivos da interface e o proxy para a API — tudo
# num domínio só (item 12 do checklist da seção 8).
#
# **Mesma origem de propósito.** A tela em `/` e a API em `/api/*` no mesmo host significa
# requisição sem CORS: sem preflight, sem lista de origens no servidor, e sem o erro mais comum
# de todos, que é a tela carregar e nenhuma requisição funcionar porque a origem publicada não
# bate com a configurada.
#
# O Caddy pede e renova o certificado do Let's Encrypt sozinho, por isso ele está aqui no lugar
# de nginx + certbot: o par que mais dá trabalho manter é justamente a renovação, e um
# certificado vencido num domingo derruba o sistema inteiro.
#
# ⚠️ Para o certificado ser emitido, o domínio precisa apontar para o IP deste servidor e as
# portas 80 e 443 precisam chegar até aqui. No Cloudflare, mantenha o registro como "DNS only"
# (nuvem cinza) até o primeiro certificado sair.
{
	# Onde o Let's Encrypt avisa de problema de renovação. Sem isto o aviso não chega a ninguém.
	email {$SOLARSYNC_ACME_EMAIL}
}

{$SOLARSYNC_DOMINIO} {
	encode zstd gzip

	# A ordem dos `handle` é a ordem em que aparecem, e o primeiro que casa vence — então as duas
	# regras específicas vêm antes do catch-all que serve a interface.

	# O /actuator/health existe para o healthcheck do container, que roda em localhost dentro do
	# container da API e não passa por aqui. De fora não há motivo para alcançá-lo: ele confirma
	# a existência do sistema e o estado do banco para quem só tem o domínio.
	handle /actuator* {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:8080 {
			# O Caddy já preenche X-Forwarded-For com o IP de quem conectou. É desse cabeçalho
			# que sai o limite de tentativas por origem (SOLARSYNC_LOGIN_CONFIAR_EM_PROXY=true
			# no compose) — sem o proxy setando isso, o limite mediria o IP do container.
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		root * /srv
		# `try_files` devolvendo o index.html é o que faz um F5 em qualquer endereço funcionar.
		# Hoje a navegação entre módulos é estado e não URL, então nada depende disto — mas no dia
		# em que entrar um roteador no frontend, a alternativa é 404 em toda página recarregada,
		# e o sintoma não aponta para cá.
		try_files {path} /index.html
		file_server
	}

	header {
		# O sistema só deve ser alcançado por HTTPS. Um ano, sem subdomínios: o preload e o
		# includeSubDomains ficam de fora enquanto conectsol.com servir outras coisas.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		# Achado A-04 da auditoria (docs/security-audit): os tokens ficam em localStorage, então
		# um script injetado os levaria. Não há sink de XSS no código hoje; a CSP é o que contém
		# o estrago do dia em que houver um, ou de uma dependência comprometida.
		#   script-src 'self'   — só o bundle do Vite; nada inline, nada de eval
		#   style-src           — o CSS do bundle e o da Google Fonts. Os `style={{...}}` do React
		#                         são propriedades do CSSOM, que a CSP não bloqueia
		#   img-src data:       — a textura SVG da tela de login é um data: URI no index.css
		#   connect-src 'self'  — a API é o mesmo domínio; qualquer outro destino é recusado
		# Nova origem externa (um CDN, um analytics) precisa entrar aqui, senão ela quebra em
		# silêncio no navegador — o erro só aparece no console.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# O index.html nunca fica em cache: é ele que aponta para os arquivos com hash no nome, então
	# um index velho no navegador serve a versão anterior do sistema depois de um deploy — e a
	# pessoa vê um bug já corrigido sem ter como saber por quê. Os assets, que têm hash, podem
	# ficar em cache para sempre.
	@index path / /index.html
	header @index Cache-Control "no-cache"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	log {
		output stdout
		format console
	}
}

# Outros sistemas hospedados neste VPS (ex.: o ReturnSync em returnsync.conectsol.com). Este Caddy
# é o único com as portas 80/443, então ele é a borda de todos: cada sistema deixa um arquivo
# `<nome>.caddy` em /opt/caddy-sites e roda o próprio container na rede docker `edge`, sem portas
# publicadas. Sem arquivo nenhum lá, o glob não casa e nada muda para o SolarSync.
import /etc/caddy/sites/*.caddy
