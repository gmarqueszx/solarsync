# Variáveis da pilha de deploy. Copie para `deploy/.env` NO SERVIDOR e preencha.
#
# ⚠️ `deploy/.env` não entra no Git (o .gitignore da raiz já cobre `.env.*`). Este arquivo é a
# referência dos nomes — nunca ponha valor de verdade aqui.
#
# Este arquivo é o superconjunto de deploy do `.env.example` da raiz, que documenta o que cada
# variável da aplicação faz. Quando divergirem, o da raiz é a explicação e este é a lista.

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
# Entra no nome do projeto do compose (solarsync-homologacao). Trocar para `producao` num
# segundo diretório é o que permite os dois ambientes no mesmo servidor, com volumes separados.
SOLARSYNC_AMBIENTE=homologacao

# Etiqueta da imagem construída. Útil para saber o que está no ar: use o hash do commit.
SOLARSYNC_VERSAO=local

# ---------------------------------------------------------------------------
# Domínio e TLS
# ---------------------------------------------------------------------------
# O domínio da API. O frontend fica noutro (Cloudflare Pages), e é ele que vai no CORS abaixo.
SOLARSYNC_API_DOMINIO=api.solarsync.conectsol.com

# Para onde o Let's Encrypt avisa de falha de renovação.
SOLARSYNC_ACME_EMAIL=joaogabriel@conectsol.com

# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------
POSTGRES_DB=solarsync
POSTGRES_USER=solarsync
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# ⚠️ Obrigatório em produção. Ausente, a aplicação sorteia um segredo no boot e todo mundo é
# deslogado a cada restart. Gere com: openssl rand -base64 48
SOLARSYNC_JWT_SEGREDO=

# Aplicada uma única vez ao admin semeado pela V3 (João Gabriel). Sem ela, ninguém entra num
# banco novo. ⚠️ Trocar o valor depois NÃO troca a senha — use POST /api/usuarios/{id}/senha.
SOLARSYNC_ADMIN_SENHA_INICIAL=
SOLARSYNC_ADMIN_EMAIL=joaogabriel@conectsol.com

# A origem do frontend, exatamente como o navegador a vê (com https, sem barra no fim). Várias
# separadas por vírgula. Errar aqui é o motivo nº 1 de "a tela carrega e nada funciona".
SOLARSYNC_CORS_ORIGENS=https://solarsync.conectsol.com

# Em homologação, `true` semeia 26 clientes cobrindo todos os estados do fluxo — é o que permite
# a equipe testar antes de a planilha ser importada. ⚠️ Em produção, `false`.
SOLARSYNC_DADOS_DE_EXEMPLO=true

# ⚠️ NÃO defina SOLARSYNC_LOGIN_CONFIAR_EM_PROXY aqui: o compose já força `true`, porque nesta
# pilha sempre há o Caddy na frente. Defini-la como `false` aqui faria o limite por origem
# medir o IP do container e trancar a empresa inteira de uma vez.

# ---------------------------------------------------------------------------
# Integrações (seção 9 do CLAUDE.md) — todas desligadas por padrão
# ---------------------------------------------------------------------------
# ⚠️ Em HOMOLOGAÇÃO, deixe as três `ativo` como false. O job do Nectar lê o CRM de verdade da
# empresa e o da saída escreve nele; o do Gmail lê a caixa real. Ligar num banco de teste faria
# a equipe treinar em cima de dados de produção.

SOLARSYNC_NECTAR_ATIVO=false
SOLARSYNC_NECTAR_TOKEN=

SOLARSYNC_NECTAR_SAIDA_ATIVO=false
# Padrão `true`, e só desligue depois de conferir a trilha nectar_etapa_sincronizacao com dados
# reais: mover a etapa é escrita no CRM da empresa e o corpo do PUT não é documentado.
SOLARSYNC_NECTAR_SAIDA_SOMENTE_CONFERENCIA=true

SOLARSYNC_GMAIL_ATIVO=false
SOLARSYNC_GMAIL_CLIENT_ID=
SOLARSYNC_GMAIL_CLIENT_SECRET=
SOLARSYNC_GMAIL_REFRESH_TOKEN=
# Ensaio: lê, registra o que faria e não muda status nenhum. Só ponha `false` depois de conferir
# email_coelba com dados reais.
SOLARSYNC_GMAIL_SOMENTE_CONFERENCIA=true
# Em produção, `true`: busca só os e-mails dos projetos que ainda esperam retorno da Coelba.
SOLARSYNC_GMAIL_SOMENTE_PROJETOS_CONHECIDOS=false

# ---------------------------------------------------------------------------
# Recursos
# ---------------------------------------------------------------------------
# Teto de memória do container da API. Ajuste para cima num servidor maior; não deixe sem teto
# (ver o comentário no compose.yaml).
SOLARSYNC_API_MEMORIA=1536m
