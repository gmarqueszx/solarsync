# Referência das variáveis de ambiente do SolarSync.
# Copie para .env (que está no .gitignore) e preencha. Nunca commite o .env.

# --- JWT (obrigatório em produção) ---
# Mínimo 32 bytes. Ausente, a aplicação gera um segredo aleatório no boot e loga um WARN:
# funciona em dev, mas em produção derrubaria a sessão de todos a cada restart.
# Gerar: openssl rand -base64 48
SOLARSYNC_JWT_SEGREDO=

# --- Primeiro acesso (break-glass) ---
# O admin semeado pela migration V3 nasce sem senha, porque o acesso previsto é pelo Google.
# Definir esta variável aplica a senha ao admin UMA VEZ (só se ele ainda não tiver senha) —
# é o que permite entrar no sistema em dev e no primeiro deploy, antes do Google estar pronto.
# Depois de trocar a senha em POST /api/usuarios/{id}/senha, remova esta variável.
SOLARSYNC_ADMIN_SENHA_INICIAL=
SOLARSYNC_ADMIN_EMAIL=joaogabriel@conectsol.com

# --- Login com Google (opcional; vazio desabilita o login Google) ---
# OAuth 2.0 Client ID criado no Google Cloud Console, tipo "Web application".
# É validado como audiência (aud) do ID token que o frontend envia.
SOLARSYNC_GOOGLE_CLIENT_ID=

# --- CORS ---
# Origens do solarsync-web, separadas por vírgula.
SOLARSYNC_CORS_ORIGENS=http://localhost:5173

# --- Banco (produção; em dev o Docker Compose provê automaticamente) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/solarsync
SPRING_DATASOURCE_USERNAME=solarsync
SPRING_DATASOURCE_PASSWORD=
