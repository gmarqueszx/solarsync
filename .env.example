# Referência das variáveis de ambiente do SolarSync.
# Copie para .env (que está no .gitignore) e preencha. Nunca commite o .env.

# --- JWT (obrigatório em produção) ---
# Mínimo 32 bytes. Ausente, a aplicação gera um segredo aleatório no boot e loga um WARN:
# funciona em dev, mas em produção derrubaria a sessão de todos a cada restart.
# Gerar: openssl rand -base64 48
SOLARSYNC_JWT_SEGREDO=

# --- Primeiro acesso ---
# O admin semeado pela migration V3 nasce sem senha, e não há auto-cadastro: sem esta variável
# ninguém consegue entrar. Defini-la aplica a senha ao admin UMA VEZ (só se ele ainda não
# tiver senha) — é o que abre o sistema em dev e no primeiro deploy.
# Depois de trocar a senha em POST /api/usuarios/{id}/senha, remova esta variável.
SOLARSYNC_ADMIN_SENHA_INICIAL=
SOLARSYNC_ADMIN_EMAIL=joaogabriel@conectsol.com

# --- Dados de exemplo (só desenvolvimento) ---
# true semeia 20 clientes cobrindo todos os estados do fluxo, passando pelos services — então
# o historico_status nasce povoado e o dashboard tem o que agregar. Idempotente. NUNCA em
# produção. Para limpar em dev: docker compose down -v
SOLARSYNC_DADOS_DE_EXEMPLO=

# --- CORS ---
# Origens do solarsync-web, separadas por vírgula.
SOLARSYNC_CORS_ORIGENS=http://localhost:5173

# --- Banco (produção; em dev o Docker Compose provê automaticamente) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/solarsync
SPRING_DATASOURCE_USERNAME=solarsync
SPRING_DATASOURCE_PASSWORD=

# --- Nectar (CRM): entrada automática de clientes ---
# Ausente ou false, o job nem existe e nenhuma chamada ao CRM acontece. Ligado, o job puxa a
# cada dez minutos as oportunidades nas etapas de entrada e cria o cliente na fila da triagem —
# só o cliente, nunca o projeto: quem decide se há pendência na Coelba é a analista.
#
# O token é gerado no Nectar em Configurações > Integrações > API, vinculado a um usuário
# administrador. Só leitura é usada.
SOLARSYNC_NECTAR_ATIVO=false
SOLARSYNC_NECTAR_TOKEN=
#
# As etapas de entrada já vêm como padrão no código, porque são o processo da ConectSol e não
# preferência de ambiente (um deploy sem elas importaria da etapa errada em silêncio):
#
#   5- Financeiro  / VALIDADO PELO FINANCEIRO
#   4- Nota Fiscal / ADIANTAR PROJETO COELBA PARA BANCO OU VENDEDOR
#
# São duas informações e não uma: o número da etapa é a sequência DENTRO do funil (a etapa 4
# existe nos treze funis) e o nome também se repete — "VALIDADO PELO FINANCEIRO" aparece no
# 5- Financeiro e, como "FUNCIONANDO | VALIDADO PELO FINANCEIRO", no 7- Instalação, onde o
# cliente já está instalado. Para mudar, sobrescreva a lista inteira:
#   solarsync.nectar.etapas-de-entrada[0].funil=5- Financeiro
#   solarsync.nectar.etapas-de-entrada[0].etapa=VALIDADO PELO FINANCEIRO
#
# O nome do funil precisa ser EXATO: ele é o único filtro que a API do Nectar respeita
# (?pipeline=<nome>). Nome errado = funil vazio = nenhum cliente entrando; o job avisa em WARN.
#
# Rótulo do campo personalizado com a data do pagamento (padrão "Data do Pagamento"):
#   solarsync.nectar.campo-data-pagamento=Data do Pagamento

# --- Gmail: leitura do retorno diário da Coelba ---
# Ausente ou false, o job nem existe. Ligado, lê a cada quinze minutos os e-mails que casam com
# a consulta e aplica aprovação/reprovação no projeto, casando pelo número da solicitação.
#
# Escopo necessário: https://www.googleapis.com/auth/gmail.readonly — o job nunca escreve na
# caixa (é por isso que a marca de "já processei" fica na tabela email_coelba).
# Como obter: criar um cliente OAuth do tipo "Aplicativo para computador" no Google Cloud
# Console, habilitar a Gmail API e rodar, uma única vez:
#   .\scripts\obter-refresh-token-gmail.ps1 -ClientId "..." -ClientSecret "..."
# O login no navegador tem de ser feito com a caixa que RECEBE o e-mail da Coelba — é ela que o
# job lê, não a que está configurada aqui.
SOLARSYNC_GMAIL_ATIVO=false
SOLARSYNC_GMAIL_CLIENT_ID=
SOLARSYNC_GMAIL_CLIENT_SECRET=
SOLARSYNC_GMAIL_REFRESH_TOKEN=
#
# ⚠️ ENSAIO ANTES DA ESTREIA. A redação real do e-mail da Coelba nunca foi observada: as listas
# de termos abaixo são o provável, não o visto. Com somente-conferência ligado, o job lê os
# e-mails de verdade, grava em email_coelba o que entendeu de cada um e NÃO muda status de
# projeto nenhum. Confira com:
#
#   SELECT recebido_em, assunto, resultado, numero_solicitacao, detalhe
#     FROM email_coelba ORDER BY recebido_em DESC;
#
# resultado = CONFERENCIA diz "eu teria mudado este projeto assim". Quando a leitura estiver
# certa, desligue — e os e-mails conferidos voltam a ser lidos e aí sim aplicados, porque
# CONFERENCIA não conta como processado.
SOLARSYNC_GMAIL_SOMENTE_CONFERENCIA=true
#
# EM PRODUÇÃO, LIGUE ESTA. Busca só os e-mails que citam o número de solicitação de um projeto
# que ainda espera retorno (encaminhado/reencaminhado, ou com vistoria em aberto). O portal manda
# ~30 e-mails por dia e só os desses projetos podem mudar alguma coisa; sem o recorte, cada
# execução registra dezenas de linhas sem efeito em email_coelba — bem onde se vai procurar por
# que um projeto mudou de status.
#
# ⚠️ Deixe FALSE durante o ensaio: num banco sem os projetos da operação a lista de números sai
# vazia, o job não busca nada e não há o que conferir. É também assim que se descobre formato
# novo, varrendo a caixa inteira.
SOLARSYNC_GMAIL_SOMENTE_PROJETOS_CONHECIDOS=false
# Consulta no formato de busca do Gmail. O recorte por remetente é o que impede o parser de
# sequer olhar e-mail de outro assunto. Padrão (o remetente real é noreplyportalgd@neoenergia.com
# — domínio .com, sem o .br; a versão antiga desta consulta não casava com nenhum e-mail):
#   solarsync.gmail.consulta=from:(noreplyportalgd@neoenergia.com OR neoenergia.com OR neoenergia.com.br OR coelba.com.br) newer_than:7d
#
# O resultado vem da linha "Etapa atual:" do e-mail, e não de adjetivo no corpo (seção 9 do
# CLAUDE.md). Uma etapa nova da Neoenergia aparece como NAO_RECONHECIDO em email_coelba e se
# resolve aqui, sem deploy — é o ajuste mais provável de ser necessário:
#   solarsync.coelba.etapas-aprovado[0]=aguardando solicitacao de vistoria
#   solarsync.coelba.etapas-em-analise[0]=em analise
#
# Os termos abaixo são o segundo caminho, usado só no e-mail sem linha de etapa — o
# cancelamento, hoje. Sem acento e sem caixa nos dois casos:
#   solarsync.coelba.termos-reprovado[0]=cancelad
